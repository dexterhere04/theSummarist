# --- Core ---
ENVIRONMENT=development
DEBUG=true

# --- Database / queue ---
DATABASE_URL=postgresql+asyncpg://summarist:summarist@localhost:5433/thesummarist
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- LLM (NVIDIA NIM / DeepSeek) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- Summarization tuning ---
LLM_MAX_INPUT_CHARS=60000
LLM_CHUNK_CHARS=12000
LLM_MAX_MAP_CALLS=48
LLM_MAP_CONCURRENCY=4
LLM_MAX_OUTPUT_TOKENS=4096

# --- OCR ---
OCR_ENGINE_LABEL=Advanced Vision V4
TESSERACT_CMD=tesseract

# --- TTS ---
TTS_PROVIDER=stub

# --- Misc ---
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=52428800
